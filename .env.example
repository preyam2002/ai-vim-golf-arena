# AI Gateway (required) — unified key used for all providers via Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Redis persistence (optional) — enables persistent scoring/leaderboard
# Set USE_REDIS=true to enable, otherwise file-backed JSON store (data/db.json) is used
USE_REDIS=false

# Upstash Redis — either UPSTASH_* or KV_* variable pair is accepted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Upstash var names (set by Vercel KV integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
